{
  "claude-ai": {
    "display_name": "Claude",
    "registration": {
      "baseApiUrl": "https://claude.ai/",
      "loginUrl": "https://claude.ai/login",
      "loginFlow": {
        "name": "cookie-capture",
        "params": {
          "cookieKeys": ["sessionKey"],
          "cookieUrl": "https://claude.ai/"
        }
      }
    },
    "scope": {
      "name": "claude-ai",
      "schema": {
        "properties": {
          "domain": {
            "const": "claude.ai"
          }
        },
        "required": ["domain"]
      }
    },
    "permissions": [
      {
        "name": "everything",
        "description": "Full access to claude.ai.",
        "schema": {}
      }
    ]
  }
}
