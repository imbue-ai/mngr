#!/bin/sh
# Runs after the package's files are gone, so nothing here may source them.
# Purging also drops what the package created outside its own file list: the
# connected desktops' records, the extension copy, the logs, and the loaded
# nftables table. The latchkey directory itself (the machine's credentials,
# the key they are kept under, and its policy) is the user's and is kept.
# The generation file is kept too, on removal and on purge alike: a package
# that another has replaced can be purged long afterwards, and removing the
# file then would make the machine read as generation 1 under the software
# that replaced it. The package installed next writes its own over it.
set -eu

case "${1:-}" in
  remove|purge)
    supervisorctl reread >/dev/null 2>&1 || true
    supervisorctl update >/dev/null 2>&1 || true
    systemctl disable '{{ firewall_unit_name }}' >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    for _lk_sshd_unit in ssh sshd; do
      systemctl is-active --quiet "$_lk_sshd_unit" && systemctl reload "$_lk_sshd_unit" >/dev/null 2>&1 || true
    done
    ;;
  *) ;;
esac
if [ "${1:-}" = purge ]; then
  {{ nft_binary_path }} delete table inet '{{ nft_table_name }}' >/dev/null 2>&1 || true
  rm -rf '{{ layout.runtime_dir }}' '{{ layout.log_dir }}'
  rm -f "${HOME:-/root}/{{ remote_latchkey_dir_name }}/{{ extensions_dir_name }}/{{ extension_filename }}"
fi
