; CLEANUP: drop this program with the reverse tunnel (see the note above
; CONTAINER_TUNNEL_KEY_FILENAME in package.py).
; Not autostarted: only a container whose agent reaches the gateway at its own
; loopback needs the tunnel, and apply-state starts it for exactly those, so a
; reboot leaves it down beside the gateway until the next provisioning pass.
; Once started, the huge startretries keeps supervisord retrying while the
; container's sshd is still coming up (or a stale remote bind clears) instead
; of giving up.
[program:{{ tunnel_program_name }}]
command={{ sh_binary_path }} {{ layout.install_dir }}/tunnel-run
user=root
autostart=false
autorestart=true
startsecs={{ supervisor_start_seconds }}
startretries={{ supervisor_tunnel_start_retries }}
stopasgroup=true
killasgroup=true
stdout_logfile={{ layout.log_dir }}/{{ tunnel_log_filename }}
stdout_logfile_maxbytes={{ supervisor_log_max_bytes }}
stdout_logfile_backups={{ supervisor_log_backups }}
redirect_stderr=true
