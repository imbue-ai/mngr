{
  "name": "minds",
  "productName": "Minds",
  "version": "0.5.0",
  "description": "Minds - Self-improving, persistent AI agents",
  "homepage": "https://github.com/imbue-ai/mngr",
  "author": "Imbue <dev@imbue.com>",
  "main": "electron/main.js",
  "scripts": {
    "prestart": "node scripts/ensure-binaries.js && pnpm run build:ui",
    "start": "MINDS_DISABLE_CRASHPAD=1 electron .",
    "build": "node scripts/build.js",
    "build:ui": "pnpm -C frontend install --frozen-lockfile && pnpm -C frontend run generate && pnpm -C frontend run build",
    "dist": "pnpm build && pnpm exec todesktop build",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test --config=test/e2e/playwright.config.js"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@todesktop/runtime": "^1.6.0",
    "electron-updater": "6.8.9",
    "latchkey": "^3.10.0",
    "semver": "^7.6.3",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@todesktop/cli": "^1.8.0",
    "electron": "40.10.1",
    "playwright": "1.60.0"
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.33.4"
  }
}
