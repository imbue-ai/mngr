#!/usr/bin/env bash
#
# propagate_changes -- sync template changes into a running minds agent and restart
#
# Syncs the default-workspace-template worktree into the agent's work_dir (container
# or local), rebuilds the frontend, restarts the agent, and restarts the Electron
# desktop client. The workspace keeps running the mngr the template pins.
#
# Usage:
#   # Remote (Docker container):
#   propagate_changes --user root --host 127.0.0.1 --port 32768 --key ~/.mngr/.../id_ed25519
#
#   # Local (non-container agent):
#   propagate_changes --target /path/to/agent/workdir
#
# Agent name resolution (first non-empty wins):
#   --agent NAME  (CLI flag)
#   auto-discovery: if exactly one agent is present under MNGR_HOST_DIR, use it
#

set -euo pipefail

# Path inference
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MNGR_REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
TEMPLATE_DIR="${MNGR_REPO_ROOT}/.external_worktrees/default-workspace-template"

if [[ ! -d "${TEMPLATE_DIR}" ]]; then
    echo "ERROR: Template directory not found: ${TEMPLATE_DIR}" >&2
    echo "       Create it with: just default-workspace-template-worktree" >&2
    exit 1
fi

# Require an activated minds env -- no implicit default to production.
# Without activation we'd silently talk to ~/.minds/ (production), which
# is almost never what an iteration-loop script should be doing. Mirrors
# the `minds-admin env deploy` / `destroy` activation check
# (`is_env_activated` in imbue.minds.bootstrap).
if [[ -z "${MINDS_ROOT_NAME:-}" ]]; then
    echo "ERROR: MINDS_ROOT_NAME is not set." >&2
    echo "       Run \`eval \"\$(uv run minds-admin env activate <name>)\"\` first" >&2
    echo "       (e.g. \`dev-<your-user>\` for your personal dev env), then" >&2
    echo "       re-run propagate_changes from the same shell." >&2
    exit 2
fi
if [[ -z "${MNGR_HOST_DIR:-}" || -z "${MNGR_PREFIX:-}" ]]; then
    echo "ERROR: MNGR_HOST_DIR and MNGR_PREFIX must both be set." >&2
    echo "       \`minds-admin env activate\` exports both alongside MINDS_ROOT_NAME -- " >&2
    echo "       did you eval its output?" >&2
    exit 2
fi

# Argument parsing
SSH_USER=""
SSH_HOST=""
SSH_PORT=""
SSH_KEY=""
LOCAL_TARGET=""
AGENT_NAME_ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --user)   SSH_USER="$2";  shift 2 ;;
        --host)   SSH_HOST="$2";  shift 2 ;;
        --port)   SSH_PORT="$2";  shift 2 ;;
        --key)    SSH_KEY="$2";   shift 2 ;;
        --target) LOCAL_TARGET="$2"; shift 2 ;;
        --agent)  AGENT_NAME_ARG="$2"; shift 2 ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            echo "Usage: propagate_changes [--agent NAME] [--user USER --host HOST --port PORT --key KEY | --target PATH]" >&2
            exit 1
            ;;
    esac
done

# Agent name resolution
list_mngr_agent_names() {
    # Print one agent name per line. Empty output means no agents found.
    uv run --directory "${MNGR_REPO_ROOT}" mngr list --format json 2>/dev/null \
        | python3 -c 'import json,sys; [print(a["name"]) for a in json.load(sys.stdin).get("agents", [])]' \
        || true
}

if [[ -n "${AGENT_NAME_ARG}" ]]; then
    AGENT_NAME="${AGENT_NAME_ARG}"
else
    echo "[auto] No --agent flag set; discovering agents..."
    CANDIDATES=$(list_mngr_agent_names)
    CANDIDATE_COUNT=$(printf '%s\n' "${CANDIDATES}" | grep -c . || true)
    if [[ "${CANDIDATE_COUNT}" -eq 0 ]]; then
        echo "ERROR: No mngr agents found. Specify one with --agent NAME." >&2
        exit 1
    elif [[ "${CANDIDATE_COUNT}" -eq 1 ]]; then
        AGENT_NAME="${CANDIDATES}"
        echo "       Using sole agent: ${AGENT_NAME}"
    else
        echo "ERROR: Multiple agents found; cannot auto-select. Pass --agent NAME. Candidates:" >&2
        printf '  %s\n' ${CANDIDATES} >&2
        exit 1
    fi
fi

# Validate: need either SSH details or a local target
if [[ -n "${SSH_HOST}" ]]; then
    if [[ -z "${SSH_USER}" || -z "${SSH_PORT}" || -z "${SSH_KEY}" ]]; then
        echo "ERROR: --host requires --user, --port, and --key" >&2
        exit 1
    fi
    MODE="remote"
elif [[ -n "${LOCAL_TARGET}" ]]; then
    if [[ ! -d "${LOCAL_TARGET}" ]]; then
        echo "ERROR: Local target directory does not exist: ${LOCAL_TARGET}" >&2
        exit 1
    fi
    MODE="local"
else
    echo "ERROR: Must specify either --host (remote) or --target (local)" >&2
    exit 1
fi

# `:- .gitignore` is rsync's dir-merge filter, applying each .gitignore under the
# source; .git is in no .gitignore.
RSYNC_EXCLUDES=(
    --filter=':- .gitignore'
    --exclude='.git'
)

# Apple's openrsync, which recent macOS ships as /usr/bin/rsync, has no --filter
# and fails the sync below with a confusing error. See apps/minds/docs/dev-setup.md.
if rsync --version 2>&1 | grep -qi openrsync; then
    echo "ERROR: your 'rsync' is Apple's openrsync, which lacks the" >&2
    echo "       --filter=':- .gitignore' support this sync needs." >&2
    echo "       Install GNU rsync and put it ahead of /usr/bin on PATH:" >&2
    echo "         brew install rsync" >&2
    echo "         rsync --version | head -1   # must NOT say 'openrsync'" >&2
    exit 2
fi

# Agent update and desktop client restart run in parallel.

# Track background PIDs for parallel execution
AGENT_PID=""
ELECTRON_PID=""

# Run a shell command from the agent's workspace root (over ssh in remote mode).
run_in_workspace() {
    if [[ "${MODE}" == "remote" ]]; then
        ssh -p "${SSH_PORT}" -i "${SSH_KEY}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
            "${SSH_USER}@${SSH_HOST}" "cd /home/user/workspace && $1" 2>&1
    else
        (cd "${LOCAL_TARGET}" && bash -c "$1") 2>&1
    fi
}

# Track A: agent stop -> sync -> frontend build -> start
agent_update() {
    echo "[1/3] Stopping agent '${AGENT_NAME}'..."
    if ! uv run --directory "${MNGR_REPO_ROOT}" mngr stop "${AGENT_NAME}" 2>&1; then
        echo "ERROR: Failed to stop agent '${AGENT_NAME}'. Known agents:" >&2
        printf '  %s\n' $(list_mngr_agent_names) >&2
        echo "       Re-run with --agent NAME to target one of the above." >&2
        return 1
    fi

    # The protect rules name what --delete must leave alone on the agent side.
    # A rule ending in "/" protects only the directory entry itself, while "/***"
    # protects the directory and everything under it. The template tracks
    # README.md files under data/, so rsync descends into data/, and only the
    # "/***" form keeps --delete away from the runtime files there that the
    # template does not carry: chat records and seeded transcripts,
    # data/.state/apps.toml, the secrets. .mngr/ holds the workspace's local
    # config layer the same way.
    # .claude/settings.local.json is generated per-agent at create time and
    # holds mngr's UserPromptSubmit hook; without protection, --delete removes
    # it and send_message then hangs the 90s submission-signal timeout.
    echo "[2/3] Syncing template into agent work_dir..."
    if [[ "${MODE}" == "remote" ]]; then
        rsync -avz --delete \
            "${RSYNC_EXCLUDES[@]}" \
            --filter='protect data/***' \
            --filter='protect .mngr/***' \
            --filter='protect .claude/settings.local.json' \
            -e "ssh -p ${SSH_PORT} -i ${SSH_KEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR" \
            "${TEMPLATE_DIR}/" "${SSH_USER}@${SSH_HOST}:/home/user/workspace/"
    else
        rsync -a --delete \
            "${RSYNC_EXCLUDES[@]}" \
            --filter='protect data/***' \
            --filter='protect .mngr/***' \
            --filter='protect .claude/settings.local.json' \
            "${TEMPLATE_DIR}/" "${LOCAL_TARGET}/"
    fi
    echo "      Done."

    echo "[2.5/3] Rebuilding system_interface frontend..."
    run_in_workspace "cd system/apps/system_interface/frontend && npm run build"
    echo "      Frontend rebuilt."

    echo "[3/3] Starting agent '${AGENT_NAME}'..."
    uv run --directory "${MNGR_REPO_ROOT}" mngr start "${AGENT_NAME}" 2>&1
    echo "      Agent started."
}

# Track B: desktop client stop and restart

electron_stop() {
    local electron_pid
    electron_pid=$(pgrep -if "electron/dist/.*electron \\.$" 2>/dev/null | head -1 || true)
    if [[ -z "${electron_pid}" ]]; then
        echo "[electron] No running desktop client; will start a fresh one at the end."
        return 0
    fi

    echo "[electron] Stopping desktop client (PID ${electron_pid})..."
    if ! kill -TERM "${electron_pid}"; then
        echo "[electron] ERROR: Failed to send SIGTERM to PID ${electron_pid}" >&2
        return 1
    fi

    # Wait for clean shutdown (typically ~1.5 seconds)
    for i in $(seq 1 20); do
        if ! ps -p "${electron_pid}" > /dev/null 2>&1; then
            echo "[electron] Desktop client stopped."
            return
        fi
        sleep 0.5
    done

    echo "[electron] ERROR: Electron PID ${electron_pid} did not exit within 10 seconds after SIGTERM." >&2
    echo "[electron] The clean shutdown chain is broken. Debug with:" >&2
    echo "[electron]   pgrep -af 'electron|uv run.*minds'" >&2
    echo "[electron]   tail -50 /tmp/minds-electron.log" >&2
    return 1
}

electron_start() {
    # Source .env and .test_env if they exist
    for envfile in "${MNGR_REPO_ROOT}/.env" "${MNGR_REPO_ROOT}/.test_env"; do
        if [[ -f "${envfile}" ]]; then
            set -a
            # shellcheck disable=SC1090
            source "${envfile}"
            set +a
        fi
    done

    export MINDS_WORKSPACE_GIT_URL="${TEMPLATE_DIR}"
    # An exported MINDS_WORKSPACE_BRANCH wins, so the error below names a remedy that works.
    if [[ -z "${MINDS_WORKSPACE_BRANCH:-}" ]]; then
        local template_branch
        # Declared on its own line: `local x="$(cmd)"` would report `local`'s status, hiding a failure.
        if ! template_branch="$(bash "${MNGR_REPO_ROOT}/scripts/current_branch.sh" "${TEMPLATE_DIR}")"; then
            echo "ERROR: Could not read the branch of ${TEMPLATE_DIR} (detached HEAD, or not a git repo)." >&2
            echo "       Check that worktree out on a branch, or export MINDS_WORKSPACE_BRANCH yourself," >&2
            echo "       then re-run propagate_changes." >&2
            return 1
        fi
        export MINDS_WORKSPACE_BRANCH="${template_branch}"
    fi
    # Explicit opt-in so the desktop client honors the MINDS_WORKSPACE_* vars
    # on any tier (the form ignores them otherwise; see _operator_workspace_default).
    export MINDS_USE_LOCAL_WORKSPACE_DEFAULTS=1

    # Select apps/minds's pinned Node (.nvmrc) so the restarted client passes
    # npm's engine-strict check; the detached Popen below inherits this PATH.
    # shellcheck disable=SC1091
    . "${SCRIPT_DIR}/select_node_version.sh" || exit 2

    echo "[electron] Starting desktop client (MINDS_WORKSPACE_GIT_URL=${TEMPLATE_DIR})..."
    python3 -c "import subprocess; subprocess.Popen(['bash','-c','cd ${MNGR_REPO_ROOT}/apps/minds && npm start'], start_new_session=True, stdout=open('/tmp/minds-electron.log','a'), stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)"
}

# Stop electron in parallel with agent update
electron_stop &
ELECTRON_STOP_PID=$!

agent_update &
AGENT_PID=$!

wait "${ELECTRON_STOP_PID}"
ELECTRON_STOP_EXIT=$?
wait "${AGENT_PID}"
AGENT_EXIT=$?

if [[ "${ELECTRON_STOP_EXIT}" -ne 0 ]]; then
    echo "ERROR: Electron stop failed (exit code ${ELECTRON_STOP_EXIT}). Not starting a new instance." >&2
    echo "       Fix the issue, then re-run propagate_changes." >&2
    exit 1
fi

if [[ "${AGENT_EXIT}" -ne 0 ]]; then
    echo "ERROR: Agent update failed (exit code ${AGENT_EXIT})" >&2
    exit 1
fi

# Start electron after everything is clean
electron_start

echo ""
echo "All changes propagated. Agent '${AGENT_NAME}' is running with updated code."
