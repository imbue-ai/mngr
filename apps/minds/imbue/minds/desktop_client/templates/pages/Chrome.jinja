{#def is_mac, is_authenticated, mngr_forward_origin, initial_workspaces, accent="", crumb_workspace_name="", crumb_agent_id="", boot_workspace_id="" #}
{#
  Persistent chrome page (titlebar + sidebar + content iframe).

  The titlebar + accent / chrome.js wiring live in the shared ChromeShell
  layout; this page fills ChromeShell's content slot with the workspace
  content surface (the sandboxed cross-origin #content-frame iframe, backed by
  the white mirror), identically in the desktop app and plain browsers. The
  workspace switcher opens as an overlay-layer iframe (see overlay_layer.js).

  is_mac controls macOS-specific styling (traffic-light padding, hidden window
  controls). mngr_forward_origin is exposed to page-level JS via a data attribute
  on the body so chrome.js can build workspace links that target the plugin's
  port directly.
#}
{# Body background tracks --titlebar-bg (ChromeShell's agent-content default) so
   the iframe's rounded top corners reveal accent color through the curve.
   Falls back to the neutral app surface (surface-primary -- white in light,
   black in dark) when no workspace is active. #}
<ChromeShell title="Minds"
             :is_mac="is_mac"
             :is_authenticated="is_authenticated"
             :mngr_forward_origin="mngr_forward_origin"
             :is_agent_content_surface="True"
             :accent="accent"
             :crumb_workspace_name="crumb_workspace_name"
             :crumb_agent_id="crumb_agent_id"
             :boot_workspace_id="boot_workspace_id"
             active_tab="">
  {# White "mirror" sized exactly like the #content-frame iframe (left:4
     / top:38 / right:4 / bottom:4 / radius:12). Sits behind the iframe
     (which covers it completely, so it is normally invisible) and shows
     through whenever the iframe's compositor surface goes briefly
     transparent -- which Chromium does on cross-origin navigation,
     between the old frame tearing down and the new frame's first paint.
     Without this mirror the shell body's accent color would flash
     through. Pointer-events:none so it never intercepts clicks. #}
  <div id="content-bg-mirror"
       class="fixed left-[4px] top-[38px] rounded-[12px] bg-surface-primary pointer-events-none"
       style="width: calc(100% - 8px); height: calc(100% - 42px);"></div>

  {# The workspace content surface: a sandboxed cross-origin iframe, armed by
     chrome.js to the displayed workspace's /forward-bridge entry URL (no eager
     src -- chrome.js reads the server-rendered boot context instead).

     The sandbox omits allow-top-navigation deliberately: a compromised
     workspace must not be able to hijack the whole app window, even with a
     user gesture. allow-popups-to-escape-sandbox keeps target=_blank links
     opening real (unsandboxed) tabs / the system browser. The permissions
     policy delegates clipboard (the terminal's copy/paste) and fullscreen
     (apps) into the frame. #}
  <iframe id="content-frame"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-downloads allow-modals"
          allow="clipboard-read *; clipboard-write *; fullscreen *"
          class="fixed left-[4px] top-[38px] border-0 rounded-[12px] bg-surface-primary"
          style="width: calc(100% - 8px); height: calc(100% - 42px); box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset;"></iframe>
</ChromeShell>
