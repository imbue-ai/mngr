{#def git_url, branch="", accounts=[], default_account_id="", color="#0b292b", mngr_forward_origin="", workspace_rows=[], launch_modes=[], backup_providers=[], region_options_by_launch_mode={}, region_selected_by_launch_mode={} #}
{#
  Create from Inspiration page (GET /create/inspiration?git_url=...).

  Landing page for an Inspiration deeplink (minds://create?git_url=...), laid
  out as a numbered vertical stepper that shows ONE step's content at a time.
  The active step's body is expanded; completed steps collapse to their number
  plus a one-line summary of the choice (click to reopen and change it); steps
  not yet reached stay hidden. The user is walked (1) -> (2) -> (3) in order.

  - Step 1: create a new workspace from the Inspiration, or add it to an
    existing one.
  - Create branch: (2) local vs. remote via the shared preset cards -- no
    default selection, an explicit click advances; then (3) confirm --
    account, the Inspiration shown as plain read-only text, a required "I
    trust this Inspiration" acknowledgment, and the "Create from Inspiration"
    submit. Advanced settings are NOT their own step: a low-key "Advanced
    settings" dashed divider above Create expands the compute / AI / backup
    provider and region selects in place. The POST carries the (possibly edited) select
    values; host name and runtime are omitted so the server defaults apply.
  - Add branch: (2) copy the "/use-inspiration <git-url>" message (the whole
    box is clickable; the skill accepts only a URL -- a deeplink branch is
    deliberately dropped); the copy advances, forcing it before (3) the
    workspace picker. Rows mirror the landing page's gating: STOPPED minds
    detour through recovery with intent=restart.

  Interactability is kept explicit: the repo is plain text (never an
  input-looking box); the only boxed value is the copyable skill message,
  whose CopyField pairs it with the Copy button that acts on it.

  The ``.hidden`` toggle sits on plain block wrappers (never combined with
  ``flex``, which would beat ``hidden`` -- see the landing rows' same gotcha).
#}
{% set _scripts %}
<script src="/_static/api_errors.js"></script>
<script>
  (function () {
    var HAS_ANY_ACCOUNT = {{ 'true' if accounts else 'false' }};

    // Same preset -> provider mapping as the create form (see Create.jinja).
    var PRESETS = {
      remote: {launch_mode: 'IMBUE_CLOUD', backup_provider: 'IMBUE_CLOUD'},
      local:  {launch_mode: 'LIMA', backup_provider: 'CONFIGURE_LATER'}
    };

    function byId(id) { return document.getElementById(id); }

    // A soft ease-out used for every reveal so the motion feels consistent.
    var EASE_OUT = 'cubic-bezier(0.16, 1, 0.3, 1)';
    // Advanced panel: the reveal/collapse motion, and the (deliberately slow)
    // auto-scroll that follows it.
    var ADV_MS = 440;
    var ADV_SCROLL_MS = 900;

    function animateReveal(el, distance, duration) {
      // Slide + fade an element into place, easing in over the first frames
      // so the start of the motion is gentle rather than abrupt.
      if (!el.animate) return;
      el.animate(
        [
          {opacity: 0, transform: 'translateY(' + (distance || 12) + 'px)'},
          {opacity: 0.6, offset: 0.4},
          {opacity: 1, transform: 'translateY(0)'}
        ],
        {duration: duration || 520, easing: EASE_OUT, fill: 'both'}
      );
    }

    function animatePop(el) {
      // A gentle overshoot when a step's circle fills in on completion.
      if (!el.animate) return;
      el.animate(
        [{transform: 'scale(0.8)'}, {transform: 'scale(1.06)', offset: 0.6}, {transform: 'scale(1)'}],
        {duration: 420, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)'}
      );
    }

    var el = {
      s1: byId('inspiration-step-1'),
      c2: byId('inspiration-step-create-2'),  // where to run
      c3: byId('inspiration-step-create-3'),  // confirm + create (advanced optional)
      a2: byId('inspiration-step-add-2'),
      a3: byId('inspiration-step-add-3')
    };
    var accountSelect = byId('account_id');
    var accountError = byId('inspiration-account-error');
    var trustCheckbox = byId('inspiration-trust');
    var trustTitle = byId('inspiration-trust-title');
    var createError = byId('inspiration-create-error');
    var submitBtn = byId('inspiration-submit');
    var presetCards = document.querySelectorAll('[data-preset]');

    // Advanced settings selects (revealed by "Enter advanced settings" on the
    // confirm step). Their values are the source of truth for the POST, and are
    // pre-filled to the chosen preset's providers so creating without opening
    // the panel submits the same config the preset implies.
    var launchSelect = byId('inspiration-launch-mode');
    var backupSelect = byId('inspiration-backup-provider');
    var regionSelect = byId('inspiration-region');
    var regionRow = byId('inspiration-region-row');
    var REGION_OPTIONS = {{ region_options_by_launch_mode | tojson }};
    var REGION_SELECTED = {{ region_selected_by_launch_mode | tojson }};

    // The whole flow is a two-variable state machine: which branch step 1
    // picked, and which step is currently expanded. One body shows at a time.
    var branch = null;      // 'create' | 'add'
    var activeStep = 1;     // 1 | 2 | 3
    var isAdvanced = false; // whether the confirm step's advanced panel is open

    function selectedPreset() {
      var card = document.querySelector('[data-preset][aria-checked="true"]');
      return card ? card.getAttribute('data-preset') : null;
    }

    function setStep(node, opts) {
      node.classList.toggle('hidden', !opts.present);
      var body = node.querySelector('[data-step-body]');
      var summary = node.querySelector('[data-step-summary]');
      var circle = node.querySelector('[data-step-circle]');
      var title = node.querySelector('[data-step-title]');
      if (body) {
        // The layout change is synchronous (instant hide/show): the next step
        // is placed at its final position immediately, so nothing has a moving
        // target. Each newly-shown body then plays ONE self-contained
        // opacity+slide reveal to that fixed position -- no competing reflow or
        // FLIP, so it never changes direction.
        var bodyWasVisible = !body.classList.contains('hidden');
        body.classList.toggle('hidden', !opts.active);
        if (opts.active && !bodyWasVisible) animateReveal(body, 16, 520);
      }
      if (summary) {
        var summaryText = summary.querySelector('[data-step-summary-text]');
        if (summaryText) summaryText.textContent = opts.summary || '';
        var summaryWasHidden = summary.classList.contains('hidden');
        var showSummary = opts.done && !!opts.summary;
        summary.classList.toggle('hidden', !showSummary);
        if (summaryWasHidden && showSummary) animateReveal(summary, 8, 380);
      }
      // The current step is a black bubble with a white number; previous
      // (completed) steps are a light-gray bubble with a dark-gray number (both
      // via the [data-step-circle] rules in <style>). The title matches: black on
      // the current step, gray on previous ones. A completed step's number and
      // title are a "click to change" affordance.
      var circleWasDone = circle.getAttribute('data-done') === '1';
      circle.setAttribute('data-done', opts.done ? '1' : '0');
      circle.setAttribute('data-state', opts.active ? 'active' : (opts.done ? 'done' : 'idle'));
      circle.classList.toggle('cursor-pointer', opts.done);
      if (!circleWasDone && opts.done) animatePop(circle);
      title.classList.toggle('text-primary', !opts.done);
      title.classList.toggle('text-secondary', opts.done);
      title.classList.toggle('cursor-pointer', opts.done);
      title.classList.toggle('hover:underline', opts.done);
    }

    function updateConnectors() {
      // A SOLID line links each completed step to the next. The current step
      // (always the last visible one) instead gets a short 3-dot "more to come"
      // stub below its number -- unless it's the final step (activeStep === 3),
      // in which case it gets nothing, so the last number reads as the end.
      var allSteps = document.querySelectorAll('.inspiration-step');
      var visible = [];
      for (var i = 0; i < allSteps.length; i++) {
        if (!allSteps[i].classList.contains('hidden')) visible.push(allSteps[i]);
      }
      for (var j = 0; j < visible.length; j++) {
        var c = visible[j].querySelector('[data-step-connector]');
        if (!c) continue;
        c.classList.remove('top-4', 'bottom-0', 'step-connector-line', 'step-connector-dots', 'hidden');
        if (j < visible.length - 1) {
          c.classList.add('top-4', 'bottom-0', 'step-connector-line');
        } else if (activeStep < 3) {
          c.classList.add('step-connector-dots');
        } else {
          c.classList.add('hidden');
        }
      }
    }

    function presetSummary() {
      var p = selectedPreset();
      if (p === 'remote') return 'Imbue Cloud';
      if (p === 'local') return 'Directly on your computer';
      return '';
    }

    function rebuildRegion() {
      // The region select is only shown for providers that place a machine in
      // a chosen region; otherwise it is hidden and disabled so no region is
      // submitted. Options are rebuilt only when the provider changes, so an
      // explicit pick survives unrelated changes (mirrors the create form).
      var mode = launchSelect.value;
      var options = REGION_OPTIONS[mode];
      if (!options || options.length === 0) {
        regionRow.classList.add('hidden');
        regionSelect.disabled = true;
        return;
      }
      if (regionSelect.getAttribute('data-mode') !== mode) {
        var preselected = REGION_SELECTED[mode] || options[0];
        regionSelect.innerHTML = '';
        for (var i = 0; i < options.length; i++) {
          var opt = document.createElement('option');
          opt.value = options[i];
          opt.textContent = options[i];
          if (options[i] === preselected) opt.selected = true;
          regionSelect.appendChild(opt);
        }
        regionSelect.setAttribute('data-mode', mode);
      }
      regionSelect.disabled = false;
      regionRow.classList.remove('hidden');
    }
    launchSelect.addEventListener('change', rebuildRegion);

    function render() {
      var branchSummary =
        branch === 'create' ? 'Create a new machine'
        : branch === 'add' ? 'Add to an existing workspace'
        : '';
      setStep(el.s1, {present: true, active: activeStep === 1, done: activeStep > 1, summary: branchSummary});

      var isCreate = branch === 'create';
      var isAdd = branch === 'add';
      setStep(el.c2, {present: isCreate && activeStep >= 2, active: isCreate && activeStep === 2, done: isCreate && activeStep > 2, summary: presetSummary()});
      setStep(el.c3, {present: isCreate && activeStep >= 3, active: isCreate && activeStep === 3, done: false, summary: ''});
      setStep(el.a2, {present: isAdd && activeStep >= 2, active: isAdd && activeStep === 2, done: isAdd && activeStep > 2, summary: 'Message copied'});
      setStep(el.a3, {present: isAdd && activeStep >= 3, active: isAdd && activeStep === 3, done: false, summary: ''});

      updateConnectors();
    }

    function chooseBranch(name) {
      if (branch !== name) {
        // Switching pathways resets the downstream progress of the old one.
        branch = name;
        isMessageCopied = false;
        markPresetSelected(null);
        resetAdvanced();
      }
      activeStep = 2;
      render();
    }

    // Collapsed: the label sits on the left. Open: the flanking dashed rules
    // appear, pushing the label to the center so the toggle reads as a divider.
    function setAdvancedRule(open) {
      var rules = byId('inspiration-toggle-advanced').querySelectorAll('[data-adv-rule]');
      for (var i = 0; i < rules.length; i++) rules[i].classList.toggle('hidden', !open);
    }

    // Smoothly expand the toggle from a left label into the centered divider.
    // The layout switch (setAdvancedRule) is made synchronously, then the label
    // FLIPs from its old left position to center while the rules grow outward
    // from it. Only transforms animate, so nothing reflows mid-motion.
    function animateAdvancedDivider() {
      var btn = byId('inspiration-toggle-advanced');
      var label = btn.querySelector('span:not([data-adv-rule])');
      var rules = btn.querySelectorAll('[data-adv-rule]');
      var startLeft = label.getBoundingClientRect().left;
      setAdvancedRule(true);
      if (!label.animate) return;
      var dx = startLeft - label.getBoundingClientRect().left;
      label.animate(
        [{transform: 'translateX(' + dx + 'px)'}, {transform: 'translateX(0)'}],
        {duration: ADV_MS, easing: EASE_OUT}
      );
      // Each rule grows out from the label side toward its outer edge.
      rules[0].style.transformOrigin = 'right center';
      rules[1].style.transformOrigin = 'left center';
      for (var i = 0; i < rules.length; i++) {
        rules[i].animate(
          [{transform: 'scaleX(0)', opacity: 0}, {transform: 'scaleX(1)', opacity: 1}],
          {duration: ADV_MS, easing: EASE_OUT}
        );
      }
    }

    // The reverse: the label slides back from center to left as the rules shrink
    // inward + fade, then the rules are hidden so it rests as a plain left label.
    function reverseAdvancedDivider() {
      var btn = byId('inspiration-toggle-advanced');
      var label = btn.querySelector('span:not([data-adv-rule])');
      var rules = btn.querySelectorAll('[data-adv-rule]');
      if (!label.animate) { setAdvancedRule(false); return; }
      // Measure the collapsed-left position without leaving the rules hidden
      // (synchronous, so no flicker), then restore them for the animation.
      var centerLeft = label.getBoundingClientRect().left;
      setAdvancedRule(false);
      var leftLeft = label.getBoundingClientRect().left;
      setAdvancedRule(true);
      var dx = centerLeft - leftLeft;
      var la = label.animate(
        [{transform: 'translateX(0)'}, {transform: 'translateX(' + (-dx) + 'px)'}],
        {duration: ADV_MS, easing: EASE_OUT, fill: 'forwards'}
      );
      rules[0].style.transformOrigin = 'right center';
      rules[1].style.transformOrigin = 'left center';
      var ras = [];
      for (var i = 0; i < rules.length; i++) {
        ras.push(rules[i].animate(
          [{transform: 'scaleX(1)', opacity: 1}, {transform: 'scaleX(0)', opacity: 0}],
          {duration: ADV_MS, easing: EASE_OUT, fill: 'forwards'}
        ));
      }
      la.onfinish = function () {
        setAdvancedRule(false);
        la.cancel();
        for (var k = 0; k < ras.length; k++) ras[k].cancel();
      };
    }

    // The page column is vertically centered (PageNarrowContainer). Opening the
    // advanced panel can make the content taller than the viewport, which would
    // otherwise re-center it and yank everything upward. pinPageColumn() freezes
    // the column at its current top -- switching the body off center-alignment
    // and compensating with a margin -- BEFORE the content grows, so growth
    // pushes downward instead of jumping up. revealAdvanced() then scrolls the
    // newly opened options into view. Both are reverted when the panel closes.
    function pageColumn() {
      var anchor = byId('inspiration-content-top');
      return anchor ? anchor.parentElement : null;
    }
    function pinPageColumn() {
      var col = pageColumn();
      if (!col || col.getAttribute('data-pinned') === '1') return;
      var before = col.getBoundingClientRect().top;
      document.body.style.alignItems = 'flex-start';
      var after = col.getBoundingClientRect().top;
      col.style.marginTop = (before - after) + 'px';
      col.setAttribute('data-pinned', '1');
    }
    function unpinPageColumn() {
      var col = pageColumn();
      if (!col || col.getAttribute('data-pinned') !== '1') return;
      col.style.marginTop = '';
      document.body.style.alignItems = '';
      col.removeAttribute('data-pinned');
    }
    // A duration-controlled window scroll (the native ``behavior: smooth`` is
    // too fast and not tunable). Eases out over ``duration`` ms; onDone fires
    // when it settles (even if there was nothing to scroll).
    function smoothScrollWindowTo(targetY, duration, onDone) {
      var startY = window.scrollY;
      var maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      targetY = Math.max(0, Math.min(targetY, maxY));
      var delta = targetY - startY;
      if (typeof requestAnimationFrame !== 'function' || duration <= 0) {
        window.scrollTo(0, targetY);
        if (onDone) onDone();
        return;
      }
      var start = null;
      function frame(ts) {
        if (start === null) start = ts;
        var t = Math.min(1, (ts - start) / duration);
        var eased = 1 - Math.pow(1 - t, 3);
        window.scrollTo(0, startY + delta * eased);
        if (t < 1) requestAnimationFrame(frame);
        else if (onDone) onDone();
      }
      requestAnimationFrame(frame);
    }

    function revealAdvanced() {
      // Let the open begin, then slowly scroll the options + Create into view.
      window.setTimeout(function () {
        if (!isAdvanced) return;   // closed again before the scroll started
        var submit = byId('inspiration-submit');
        if (!submit) return;
        var margin = 16;
        var bottom = submit.getBoundingClientRect().bottom;
        var targetY = window.scrollY;
        if (bottom > window.innerHeight - margin) {
          targetY = window.scrollY + (bottom - window.innerHeight + margin);
        }
        smoothScrollWindowTo(targetY, ADV_SCROLL_MS);
      }, 160);
    }

    // Collapse the panel by animating its height (and top margin) to zero as it
    // fades: the Create button below slides straight up as the options vanish,
    // instead of waiting on a scroll. Hides it and runs onDone once settled.
    function collapseAdvancedPanel(onDone) {
      var adv = byId('inspiration-advanced');
      if (!adv.animate) { adv.classList.add('hidden'); if (onDone) onDone(); return; }
      adv.getAnimations().forEach(function (a) { a.cancel(); });
      var h = adv.getBoundingClientRect().height;
      var mt = getComputedStyle(adv).marginTop;
      adv.style.overflow = 'hidden';
      var anim = adv.animate(
        [{height: h + 'px', marginTop: mt, opacity: 1},
         {height: '0px', marginTop: '0px', opacity: 0}],
        {duration: ADV_MS, easing: EASE_OUT, fill: 'forwards'}
      );
      anim.onfinish = function () {
        adv.classList.add('hidden');
        adv.style.overflow = '';
        anim.cancel();
        if (onDone) onDone();
      };
    }

    function openAdvanced() {
      var adv = byId('inspiration-advanced');
      byId('inspiration-advanced-chevron').style.transform = 'rotate(180deg)';
      pinPageColumn();               // freeze the column BEFORE the content grows
      adv.classList.remove('hidden');
      animateAdvancedDivider();      // reveal + morph the divider open
      animateReveal(adv, 12, ADV_MS);
      revealAdvanced();              // then slowly scroll the options into view
    }

    function closeAdvanced() {
      // Reverse the divider morph, and collapse the panel's height (not just its
      // opacity) so the Create button rises immediately as the options vanish.
      // The shrinking content scrolls the view back up on its own; release the
      // pinned column once the collapse settles.
      byId('inspiration-advanced-chevron').style.transform = '';
      reverseAdvancedDivider();
      collapseAdvancedPanel(function () {
        if (isAdvanced) return;    // re-opened during the collapse; leave it open
        unpinPageColumn();
      });
    }

    function resetAdvanced() {
      // Collapse the optional advanced panel back to hidden (its select values
      // persist, so reopening shows the prior picks); reset the chevron and the
      // divider back to a plain left-aligned label, and release the pinned column.
      isAdvanced = false;
      byId('inspiration-advanced').classList.add('hidden');
      byId('inspiration-advanced-chevron').style.transform = '';
      setAdvancedRule(false);
      unpinPageColumn();
    }

    // Clicking a completed step's number or title reopens it (steps back).
    function wireGoBack(node, target, onGo) {
      function go() {
        if (activeStep > target) {
          if (onGo) onGo();
          activeStep = target;
          render();
        }
      }
      node.querySelector('[data-step-title]').addEventListener('click', go);
      node.querySelector('[data-step-circle]').addEventListener('click', go);
    }
    wireGoBack(el.s1, 1);
    wireGoBack(el.c2, 2);
    wireGoBack(el.a2, 2);

    byId('choose-new-workspace').addEventListener('click', function () { chooseBranch('create'); });
    byId('choose-add-existing').addEventListener('click', function () { chooseBranch('add'); });
    var emptyToNew = byId('inspiration-empty-to-new');
    if (emptyToNew) emptyToNew.addEventListener('click', function (e) { e.preventDefault(); chooseBranch('create'); });

    // Confirm step: the "Advanced settings" dashed divider (above Create)
    // expands the provider/region selects in place, rotating its chevron.
    byId('inspiration-toggle-advanced').addEventListener('click', function () {
      isAdvanced = !isAdvanced;
      if (isAdvanced) openAdvanced();
      else closeAdvanced();
    });

    var isMessageCopied = false;
    var copyBtn = byId('inspiration-copy-btn');
    var copyBox = byId('inspiration-skill-message').parentElement;
    function doCopy() {
      if (isMessageCopied) return; // already copying/advancing
      var message = byId('inspiration-skill-message').value;
      try {
        if (navigator.clipboard) navigator.clipboard.writeText(message);
      } catch (e) {
        /* ignore */
      }
      // Confirm the copy by turning the whole box green (light success surface
      // + green border) and the button solid green with "Copied". Set via
      // inline style with the theme's success CSS variables so it always wins
      // and stays theme-aware (the ``!``-important utility variants are not in
      // the compiled CSS); the ``.copy-box`` transition (box) and
      // ``transition-colors`` (button) fade the green in.
      copyBox.style.borderColor = 'var(--c-success)';
      copyBox.style.backgroundColor = 'var(--c-success-surface)';
      copyBtn.textContent = 'Copied';
      copyBtn.style.backgroundColor = 'var(--c-success)';
      copyBtn.style.color = '#ffffff';
      // Copying is what advances to the picker, so the user cannot enter a
      // workspace without the message in hand. Hold long enough that the green
      // confirmation clearly registers before the next step slides up.
      isMessageCopied = true;
      setTimeout(function () { activeStep = 3; render(); }, 1000);
      // Reset after it has collapsed away, so reopening step 2 shows a fresh
      // "Copy" box rather than a stale green state.
      setTimeout(function () {
        isMessageCopied = false;
        copyBtn.textContent = 'Copy';
        copyBtn.style.backgroundColor = '';
        copyBtn.style.color = '';
        copyBox.style.borderColor = '';
        copyBox.style.backgroundColor = '';
      }, 2200);
    }
    // The whole box is clickable, not just the button.
    copyBox.addEventListener('click', doCopy);

    window.inspirationRowClick = function (row) {
      var agentId = row.dataset.agentId;
      var ret = row.dataset.defaultHref || '';
      var target;
      if (row.dataset.liveness === 'STOPPED') {
        // Same shortcut as the landing rows: the mind is known-stopped, so
        // route straight to recovery, which cold-boots the host immediately
        // (intent=restart is required -- the health tracker has never probed
        // a stopped mind, so without it recovery bounces back to the loader).
        target = '/agents/' + encodeURIComponent(agentId)
          + '/recovery?return_to=' + encodeURIComponent(ret) + '&intent=restart';
      } else {
        target = ret;
      }
      if (window.minds && window.minds.navigateContent) window.minds.navigateContent(target);
      else window.location = target;
    };

    function markPresetSelected(name) {
      for (var i = 0; i < presetCards.length; i++) {
        var isOn = presetCards[i].getAttribute('data-preset') === name;
        presetCards[i].setAttribute('aria-checked', isOn ? 'true' : 'false');
      }
    }

    function hideAccountError() {
      accountError.classList.add('hidden');
      accountSelect.classList.remove('!ring-1', 'ring-important');
    }

    function showAccountError() {
      accountError.classList.remove('hidden');
      accountSelect.classList.add('!ring-1', 'ring-important');
    }

    for (var i = 0; i < presetCards.length; i++) {
      presetCards[i].addEventListener('click', function () {
        var name = this.getAttribute('data-preset');
        markPresetSelected(name);
        hideAccountError();
        // Pre-fill the advanced selects with this preset's providers so
        // whichever settings path the user takes submits a consistent config.
        var preset = PRESETS[name];
        if (preset) {
          launchSelect.value = preset.launch_mode;
          backupSelect.value = preset.backup_provider;
          rebuildRegion();
        }
        // A choice advances to the settings step, which always re-offers the
        // defaults-vs-advanced choice on (re)entry.
        resetAdvanced();
        activeStep = 3;
        render();
      });
    }

    accountSelect.addEventListener('change', hideAccountError);

    function syncTrustGate() {
      // Gray out + disable Create until the Inspiration is acknowledged, and
      // keep the acknowledgment red until it is (it is not verified by Imbue).
      var ok = trustCheckbox.checked;
      submitBtn.disabled = !ok;
      trustTitle.classList.toggle('text-important', !ok);
      trustTitle.classList.toggle('text-primary', ok);
    }
    trustCheckbox.addEventListener('change', syncTrustGate);

    function openSigninModal() {
      if (window.minds && window.minds.openSigninModal) {
        window.minds.openSigninModal();
      } else {
        window.location.href = '/auth/signin-modal';
      }
    }

    function showCreateError(message) {
      createError.textContent = message || 'Something went wrong. Please try again.';
      createError.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create from Inspiration';
    }

    byId('inspiration-form').addEventListener('submit', function (e) {
      e.preventDefault();
      createError.classList.add('hidden');
      // The Create button is disabled until the box is checked; this guards
      // the Enter-key path too.
      if (!trustCheckbox.checked) return;
      // The advanced selects are the source of truth (they are pre-filled to
      // the chosen preset, then optionally edited in the settings step).
      // Imbue Cloud needs an account: signed out opens the sign-in modal,
      // signed in surfaces the picker error (create-form parity).
      if (launchSelect.value === 'IMBUE_CLOUD' && accountSelect.value === '') {
        if (HAS_ANY_ACCOUNT) showAccountError();
        else openSigninModal();
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating...';
      var body = {
        git_url: byId('inspiration-git-url').value,
        branch: byId('inspiration-branch').value,
        color: byId('inspiration-color').value,
        launch_mode: launchSelect.value,
        backup_provider: backupSelect.value,
        region: regionSelect.disabled ? '' : regionSelect.value,
        account_id: accountSelect.value
      };
      fetch('/api/v1/workspaces', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(function (r) {
        return r.json().then(function (data) { return { status: r.status, data: data || {} }; });
      }).then(function (res) {
        if (res.status === 202 && res.data.operation_id) {
          window.location = '/creating/' + res.data.operation_id;
          return;
        }
        var err = normalizeApiError(res.data);
        if (err.redirect_url) {
          window.location = err.redirect_url;
          return;
        }
        showCreateError(err.message);
      }).catch(function () {
        showCreateError('Could not reach the server. Please try again.');
      });
    });

    render();
  })();
</script>
{% endset %}
<PageNarrowContainer title="Create from Inspiration" page_label="New workspace" padding="form" max_width="max-w-[720px]" scripts={{ _scripts }}>

  <style>
    /* Step circles carry no border. The CURRENT step is a solid black bubble
       with a white number; PREVIOUS (completed) steps are a light-gray bubble
       with a dark-gray number. Both fills are opaque so the connector line stays
       hidden behind the circle. Theme-aware via the surface + text tokens; the
       base ``transition-colors`` fades between states. */
    [data-step-circle][data-state="active"] {
      background-color: var(--c-surface-inverse);
      color: var(--c-text-inverse-primary);
    }
    [data-step-circle][data-state="done"] {
      background-color: color-mix(in srgb, var(--c-text-primary) 10%, var(--c-surface-primary));
      color: var(--c-text-secondary);
    }

    /* Completed steps link to the next with a SOLID line whose color matches the
       completed circle's fill exactly (so the line doesn't read as darker than
       the bubbles). The current step instead gets a short 3-dot "more to come"
       stub below its number -- but only when it isn't the final step.
       updateConnectors() switches a connector between the two (or hides it). */
    .step-connector-line {
      width: 1px;
      background-color: color-mix(in srgb, var(--c-text-primary) 10%, var(--c-surface-primary));
    }
    .step-connector-dots {
      top: 2.25rem;
      height: 20px;
      width: 3px;
      background-image: radial-gradient(circle, var(--c-border-strong) 1.1px, transparent 1.6px);
      background-size: 3px 7px;
      background-repeat: repeat-y;
      background-position: center top;
    }

    /* Hover animation for the copyable skill-message box: a slight lift with a
       stronger border and soft shadow. Border/background transitions also carry
       the green "Copied" confirmation (set via inline style, which overrides the
       hover border while the green is showing). */
    .copy-box {
      transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 300ms ease,
                  background-color 300ms ease,
                  box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .copy-box:hover {
      transform: translateY(-2px);
      border-color: var(--c-border-strong);
      box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.35);
    }
    .copy-box:active {
      transform: translateY(0);
    }
    /* The whole box copies on click, so the read-only value shows the clickable
       pointer cursor rather than the default text I-beam. */
    .copy-box input {
      cursor: pointer;
    }
  </style>

  <div id="inspiration-content-top" class="text-center mb-8">
    <h1 class="type-heading-lg text-primary">You've opened an Inspiration</h1>
    {# Plain read-only text, deliberately not styled like an input. #}
    <p class="type-body text-secondary font-mono mt-2 break-all">{{ git_url }}</p>
  </div>

  {# Numbered vertical stepper. Each step's ``.hidden`` toggle is on this plain
     wrapper; the row layout sits on the inner ``.flex``. Only the active step's
     [data-step-body] is shown; completed steps show [data-step-summary]. #}
  <div>

    {# ---- Step 1: choose the pathway (always present) ---- #}
    <div id="inspiration-step-1" class="inspiration-step">
      <div class="flex gap-3">
        <div class="relative flex flex-col items-center self-stretch">
          <span data-step-circle class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full type-body font-semibold shrink-0 transition-colors duration-300">1</span>
          <span data-step-connector class="absolute hidden"></span>
        </div>
        <div class="flex-1 pb-6 min-w-0">
          <h2 data-step-title class="type-heading text-primary flex items-center min-h-8">What would you like to do with it?</h2>
          {# Collapsed answer: a check + the chosen option, tucked close under
             its question with extra room below so it clearly groups with the
             question it answers (hidden toggle on this block; flex on inner to
             avoid the flex-beats-hidden gotcha). #}
          <div data-step-summary class="hidden mt-0.5 mb-2">
            <span class="flex items-center gap-2 type-body text-secondary">
              <span class="text-success shrink-0"><Icon16 name="check" /></span>
              <span data-step-summary-text></span>
            </span>
          </div>
          <div data-step-body class="flex flex-col gap-3 mt-4">
            <Button variant="secondary" block id="choose-new-workspace">Create a new machine</Button>
            <Button variant="secondary" block id="choose-add-existing">Add to an existing machine</Button>
          </div>
        </div>
      </div>
    </div>

    {# ---- Create branch, step 2: local vs. remote ---- #}
    <div id="inspiration-step-create-2" class="inspiration-step hidden">
      <div class="flex gap-3">
        <div class="relative flex flex-col items-center self-stretch">
          <span data-step-circle class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full type-body font-semibold shrink-0 transition-colors duration-300">2</span>
          <span data-step-connector class="absolute hidden"></span>
        </div>
        <div class="flex-1 pb-6 min-w-0">
          <h2 data-step-title class="type-heading text-primary flex items-center min-h-8">Where should it run?</h2>
          {# Collapsed answer: a check + the chosen option, tucked close under
             its question with extra room below so it clearly groups with the
             question it answers (hidden toggle on this block; flex on inner to
             avoid the flex-beats-hidden gotcha). #}
          <div data-step-summary class="hidden mt-0.5 mb-2">
            <span class="flex items-center gap-2 type-body text-secondary">
              <span class="text-success shrink-0"><Icon16 name="check" /></span>
              <span data-step-summary-text></span>
            </span>
          </div>
          <div data-step-body class="mt-4" role="radiogroup" aria-label="Where to run your machine">
            <CreatePresetCards selected_preset="" />
          </div>
        </div>
      </div>
    </div>

    {# ---- Create branch, step 3: confirm + create (advanced optional) ---- #}
    <div id="inspiration-step-create-3" class="inspiration-step hidden">
      <div class="flex gap-3">
        <div class="relative flex flex-col items-center self-stretch">
          <span data-step-connector class="absolute hidden"></span>
          <span data-step-circle class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full type-body font-semibold shrink-0 transition-colors duration-300">3</span>
        </div>
        <div class="flex-1 pb-6 min-w-0">
          <h2 data-step-title class="type-heading text-primary flex items-center min-h-8">Confirm and create</h2>
          <div data-step-summary class="hidden mt-0.5 mb-2">
            <span class="flex items-center gap-2 type-body text-secondary">
              <span class="text-success shrink-0"><Icon16 name="check" /></span>
              <span data-step-summary-text></span>
            </span>
          </div>
          <div data-step-body class="mt-4">
            <form id="inspiration-form">
              <input type="hidden" id="inspiration-git-url" value="{{ git_url }}">
              <input type="hidden" id="inspiration-branch" value="{{ branch }}">
              <input type="hidden" id="inspiration-color" value="{{ color }}">

              <p id="inspiration-create-error" role="alert" class="hidden mb-4 type-helper text-important"></p>

              <div class="mb-4">
                <p class="type-label uppercase tracking-wide text-secondary">Creating from</p>
                {# Plain read-only text, deliberately not styled like an input. #}
                <p class="type-body text-primary font-mono mt-1 break-all">{{ git_url }}</p>
                {% if branch %}
                  <p class="type-helper text-tertiary mt-1">Version: {{ branch }}</p>
                {% endif %}
              </div>

              {# Account: an uppercase label with a bordered dropdown below (the
                 shared Select component, per the styleguide) so multi-account
                 users can switch. #}
              <div class="mb-4">
                <p class="type-label uppercase tracking-wide text-secondary">Account</p>
                <div class="mt-1">
                  <Select id="account_id" name="account_id" width="w-72">
                    {% for acct in accounts %}
                      <option value="{{ acct.user_id }}"{% if acct.user_id == default_account_id %} selected{% endif %}>{{ acct.email }}</option>
                    {% endfor %}
                    <option value=""{% if not default_account_id %} selected{% endif %}>No account (private machine)</option>
                  </Select>
                </div>
              </div>
              <p id="inspiration-account-error" class="hidden mb-4 type-helper text-important">
                Pick an account to use Imbue Cloud, or choose the local preset.
              </p>

              <div class="mt-6">
                {# Required acknowledgment: shown red until checked, and the
                   Create button below stays disabled/grayed until it is. #}
                <label class="flex items-center gap-3 cursor-pointer">
                  <input type="checkbox" id="inspiration-trust" class="shrink-0">
                  <span>
                    <span id="inspiration-trust-title" class="type-body font-semibold text-important transition-colors duration-200">I trust this Inspiration</span>
                    <span class="block type-helper text-tertiary">Inspirations are community content. This one has not been approved or verified by Imbue.</span>
                  </span>
                </label>
              </div>

              {# Advanced settings are not their own step. Collapsed, the toggle is
                 just a low-key "Advanced settings" label on the left; opening it
                 turns it into a full dashed divider with the label centered
                 (mirroring the dashed <hr> in the create form's advanced view),
                 marking the section break above the revealed selects. The
                 flanking dashed rules are hidden until open (data-adv-rule). The
                 revealed selects sit inline with no box, pre-filled to the chosen
                 preset, so creating without opening it submits the same config. #}
              <div class="mt-8">
                <button type="button" id="inspiration-toggle-advanced"
                        class="group w-full flex items-center gap-3 cursor-pointer bg-transparent">
                  <span data-adv-rule class="flex-1 border-t border-dashed border-default hidden"></span>
                  <span class="flex items-center gap-1 type-helper text-tertiary transition-colors duration-200 group-hover:text-primary">
                    Advanced settings
                    <span id="inspiration-advanced-chevron" class="transition-transform duration-200"><Icon16 name="chevron-down" /></span>
                  </span>
                  <span data-adv-rule class="flex-1 border-t border-dashed border-default hidden"></span>
                </button>
                <div id="inspiration-advanced" class="hidden mt-4">
                  <div class="flex flex-col gap-6">
                    <div class="flex items-center justify-between gap-4">
                      <FormLabel target="inspiration-launch-mode" inline>Compute provider</FormLabel>
                      <Select id="inspiration-launch-mode" name="inspiration_launch_mode" width="w-48">
                        {% for mode in launch_modes %}
                          <option value="{{ mode.value }}">{{ mode.value | lower }}</option>
                        {% endfor %}
                      </Select>
                    </div>
                    <div class="flex items-center justify-between gap-4">
                      <FormLabel target="inspiration-backup-provider" inline>Backup provider</FormLabel>
                      <Select id="inspiration-backup-provider" name="inspiration_backup_provider" width="w-48">
                        {% for provider in backup_providers %}
                          <option value="{{ provider.value }}">{% if provider.value == 'API_KEY' %}manual{% else %}{{ provider.value | lower }}{% endif %}</option>
                        {% endfor %}
                      </Select>
                    </div>
                    <div id="inspiration-region-row" class="hidden">
                      <div class="flex items-center justify-between gap-4">
                        <FormLabel target="inspiration-region" inline>Region</FormLabel>
                        <Select id="inspiration-region" name="inspiration_region" width="w-48"></Select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="mt-6">
                <ButtonSubmit id="inspiration-submit" variant="primary" block disabled extra="transition-all duration-200">Create from Inspiration</ButtonSubmit>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    {# ---- Add branch, step 2: copy the skill message ---- #}
    <div id="inspiration-step-add-2" class="inspiration-step hidden">
      <div class="flex gap-3">
        <div class="relative flex flex-col items-center self-stretch">
          <span data-step-circle class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full type-body font-semibold shrink-0 transition-colors duration-300">2</span>
          <span data-step-connector class="absolute hidden"></span>
        </div>
        <div class="flex-1 pb-6 min-w-0">
          <h2 data-step-title class="type-heading text-primary flex items-center min-h-8">Copy the message</h2>
          {# Collapsed answer: a check + the chosen option, tucked close under
             its question with extra room below so it clearly groups with the
             question it answers (hidden toggle on this block; flex on inner to
             avoid the flex-beats-hidden gotcha). #}
          <div data-step-summary class="hidden mt-0.5 mb-2">
            <span class="flex items-center gap-2 type-body text-secondary">
              <span class="text-success shrink-0"><Icon16 name="check" /></span>
              <span data-step-summary-text></span>
            </span>
          </div>
          <div data-step-body class="mt-4">
            <p class="type-body text-secondary mb-4">
              You'll paste this into the chat of the machine you want to add
              this Inspiration to.
            </p>
            <CopyField :value="'/use-inspiration ' ~ git_url" id="inspiration-skill-message" aria-label="Inspiration chat message" extra="copy-box cursor-pointer">
              <Button variant="ghost" id="inspiration-copy-btn" extra="transition-colors duration-300 shrink-0">Copy</Button>
            </CopyField>
            {% if branch %}
              <p class="type-helper text-tertiary mt-2">
                The link's branch ({{ branch }}) applies only when creating a new machine;
                the message above always uses the Inspiration's published version.
              </p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {# ---- Add branch, step 3: pick the workspace ---- #}
    <div id="inspiration-step-add-3" class="inspiration-step hidden">
      <div class="flex gap-3">
        <div class="relative flex flex-col items-center self-stretch">
          <span data-step-circle class="relative z-10 flex items-center justify-center w-8 h-8 rounded-full type-body font-semibold shrink-0 transition-colors duration-300">3</span>
          <span data-step-connector class="absolute hidden"></span>
        </div>
        <div class="flex-1 pb-6 min-w-0">
          <h2 data-step-title class="type-heading text-primary flex items-center min-h-8">Select a machine</h2>
          {# Collapsed answer: a check + the chosen option, tucked close under
             its question with extra room below so it clearly groups with the
             question it answers (hidden toggle on this block; flex on inner to
             avoid the flex-beats-hidden gotcha). #}
          <div data-step-summary class="hidden mt-0.5 mb-2">
            <span class="flex items-center gap-2 type-body text-secondary">
              <span class="text-success shrink-0"><Icon16 name="check" /></span>
              <span data-step-summary-text></span>
            </span>
          </div>
          <div data-step-body class="mt-4">
            <p class="type-body text-secondary mb-4">
              It will open so you can paste the copied message into its chat.
            </p>
            {% if workspace_rows %}
              <div class="flex flex-col gap-1.5">
                {% for row in workspace_rows %}
                  {% set accent_style = "--workspace-accent: " ~ row.accent ~ ";" %}
                  {% set goto_href = mngr_forward_origin ~ "/goto/" ~ row.agent_id ~ "/" %}
                  <Card layout="row" interactive
                        extra="accent-spine relative overflow-hidden"
                        :style="accent_style"
                        :data-agent-id="row.agent_id"
                        :data-liveness="row.liveness"
                        :data-default-href="goto_href"
                        onclick="window.inspirationRowClick(this)">
                    <span class="flex-1 font-semibold text-primary pl-1">{{ row.name }}</span>
                    {% if row.liveness == "STOPPED" %}
                      <StatusBadge>Stopped</StatusBadge>
                    {% endif %}
                    {# Right-pointing arrow: selecting this workspace opens it. #}
                    <span class="text-tertiary shrink-0"><Icon16 name="chevron-right" /></span>
                  </Card>
                {% endfor %}
              </div>
            {% else %}
              <p class="type-body text-secondary">
                You don't have any machines yet.
                <a href="#" id="inspiration-empty-to-new" class="text-accent hover:underline">Create a new one from this Inspiration</a> instead.
              </p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</PageNarrowContainer>
