{#
  Error-reporting notice screen. Shown just after login (the user is authenticated)
  while MindsConfig.error_reporting_consent_given is False -- i.e. once per install, on
  first launch. Reporting defaults on for new installs; this screen has no opt-out toggle
  (it points the user to Settings -> Error reporting, where it can be turned off). "I agree"
  records that the notice was acknowledged (POST /consent) and flips the consent-given flag,
  then reloads the app, which now proceeds past this screen to the landing content.
#}
{% set _scripts %}
<script>
  (function() {
    var continueBtn = document.getElementById('consent-continue');

    continueBtn.addEventListener('click', function() {
      continueBtn.disabled = true;
      fetch('/consent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      }).then(function() {
        window.location.href = '/';
      }).catch(function() {
        // Even if recording the acknowledgment failed, move on; the consent flag stays
        // unset so the notice will simply reappear on the next launch.
        window.location.href = '/';
      });
    });
  })();
</script>
{% endset %}
<ChromeShell title="Error reporting" scripts={{ _scripts }}>
  <div class="min-h-[calc(100dvh_-_38px)] flex items-center justify-center">
    <div class="max-w-md w-full px-6">
      <h1 class="type-heading-lg text-primary mb-2">Help improve Minds</h1>
      <p class="text-secondary type-body mb-4">
        While Minds is in its pre-release phase it defaults to reporting errors and sharing logs with
        Imbue when things go wrong.
      </p>
      <p class="text-tertiary type-helper mb-4">
        Privacy and transparency are core values for Imbue. The reports that we collect include
        diagnostic details about the error and your setup, and that can be identifying at times (e.g.,
        an email account). You can turn off error reporting in Settings &rarr; Error reporting.
      </p>
      <p class="text-tertiary type-helper mb-8">
        Our privacy policy is <Link href="https://imbue.com/privacy/" target="_blank" rel="noopener">here</Link>.
      </p>

      <Button variant="primary" block id="consent-continue">I agree</Button>
    </div>
  </div>
</ChromeShell>
