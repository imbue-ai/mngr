{#def create_attempt_id, workspace_name, state, error, error_kind, log_tail_text, provider_label #}
{#
  Record-backed create attempt detail page, shown at /creating/<id> when no live
  create attempt is tracked for the id but its pending-create-attempt record survives.

  state == "interrupted": an app restart killed the create mid-flight. The
  page offers Retry (reopens the create form pre-filled from the record --
  non-destructive; the cleanup happens on resubmit) and Discard (destroys the
  leftover half-built host when one exists, streaming the destroy output like
  the workspace destroy page, then removes the record).

  state == "failed": the create attempt failed; the record's persisted error and
  create-attempt-log tail stay viewable until the row is dismissed.
#}
{% set _scripts %}
<script src="/_static/create_attempt_record.js" defer></script>
{% endset %}
<ChromeShell title={{ "Workspace create attempt: " ~ workspace_name }}
      page_label="New workspace"
      body_class="bg-surface-primary text-primary font-sans antialiased"
      scripts={{ _scripts }}>
  <PageContainer>
    <div id="create-attempt-record-page" data-create-attempt-id="{{ create_attempt_id }}" data-state="{{ state }}">
      <h1 class="type-heading text-primary">{{ workspace_name }}</h1>
      <p class="type-helper text-tertiary mb-4">
        {{ create_attempt_id }}{% if provider_label %} &middot; {{ provider_label }}{% endif %}
      </p>

      {% set retry_href = "/create?retry=" ~ create_attempt_id %}
      {% if state == 'interrupted' %}
        <div id="record-view">
          <StatusBadge variant="warn">Interrupted</StatusBadge>
          <p class="type-body text-secondary mt-3">
            This workspace was still being created when the app last quit, so the
            create attempt did not finish. You can retry it (the setup form reopens with
            everything filled in) or discard it; either way any half-built
            leftovers are cleaned up.
          </p>
          <div class="mt-4 flex gap-3">
            <ButtonLink :href="retry_href" variant="primary">Retry</ButtonLink>
            <Button variant="secondary" id="create-attempt-discard-btn">Discard</Button>
          </div>
        </div>
      {% else %}
        <div id="record-view">
          <StatusBadge variant="error">Create failed</StatusBadge>
          <Notice variant="error" class="mt-3">
            <span class="font-mono type-helper break-words whitespace-pre-wrap">{{ error or "unknown error" }}</span>
          </Notice>
          {% if error_kind == 'GITHUB_AUTH_REQUIRED' %}
            <div class="text-left type-body text-secondary mt-3">
              <p>
                This repository looks private, or it does not exist: GitHub asked for
                credentials, and none on this computer could open it. If you have access
                to the repository, sign in to GitHub on this computer and try again.
              </p>
            </div>
          {% elif error_kind == 'GIT_AUTH_REQUIRED' %}
            <div class="text-left type-body text-secondary mt-3">
              <p>
                This repository looks private, or it does not exist: it asked for
                credentials, and none on this computer could open it. If you have access
                to it, make sure your git credentials for this host are set up on this
                computer, then try again.
              </p>
            </div>
          {% endif %}
          {% if log_tail_text %}
            <h2 class="type-label text-secondary mt-6 mb-2">Create attempt log (tail)</h2>
            <div class="dark p-3 bg-surface-primary text-secondary font-mono type-helper rounded-lg max-h-[320px] overflow-y-auto whitespace-pre-wrap border border-subtle">{{ log_tail_text }}</div>
          {% endif %}
          <div class="mt-4 flex gap-3">
            <ButtonLink href="/create" variant="primary">Back to setup</ButtonLink>
            <Button variant="secondary" id="create-attempt-dismiss-btn">Dismiss</Button>
          </div>
        </div>
      {% endif %}

      {# Discard progress: hidden until the Discard button starts the detached
         destroy; then the destroy output streams here, mirroring the
         workspace destroy page. #}
      <div id="discard-view" class="hidden">
        <div id="discard-status" class="my-4 flex items-center gap-2">
          <Spinner />
          <span class="text-primary">Cleaning up...</span>
        </div>
        <div id="discard-log"
             class="dark p-3 bg-surface-primary text-secondary font-mono type-helper rounded-lg max-h-[420px] overflow-y-auto whitespace-pre-wrap border border-subtle"></div>
        <div id="discard-actions" class="mt-6 flex gap-3 hidden">
          <Button variant="primary" id="discard-retry-btn">Retry cleanup</Button>
        </div>
      </div>

      <p id="create-attempt-record-error" class="hidden type-helper text-important mt-4" role="alert"></p>

      <div class="mt-8">
        <Link href="/" extra="type-helper">&larr; Back to workspaces</Link>
      </div>
    </div>
  </PageContainer>
</ChromeShell>
